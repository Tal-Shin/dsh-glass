{
  "name": "@tal-shin/dsh-cupertino",
  "version": "0.1.1",
  "type": "module",
  "description": "Apple-style geometry, type and shadows.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "displayName": "Cupertino",
    "description": "Apple-style geometry, type and shadows."
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "Tal-Shin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tal-Shin/dsh-glass.git",
    "directory": "cupertino"
  },
  "homepage": "https://github.com/Tal-Shin/dsh-glass/tree/main/cupertino#readme"
}
