{
  "name": "@tal-shin/dsh-boot-veil",
  "version": "1.0.0",
  "type": "module",
  "description": "First-paint boot screen: a centred mark and a slim progress pill, gone as soon as the app renders.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "displayName": "Boot Veil",
    "description": "First-paint boot screen shown until the app renders."
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "Tal-Shin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tal-Shin/dsh-glass.git",
    "directory": "boot-veil"
  },
  "homepage": "https://github.com/Tal-Shin/dsh-glass/tree/main/boot-veil#readme"
}
