{
  "name": "@tal-shin/dsh-turn-resume",
  "version": "1.1.0",
  "type": "module",
  "description": "After an interrupted turn, a chip under the composer drafts the continuation.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "displayName": "Turn Resume",
    "description": "A chip under the composer that drafts the continuation after an interrupted turn."
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "Tal-Shin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tal-Shin/dsh-glass.git",
    "directory": "turn-resume"
  },
  "homepage": "https://github.com/Tal-Shin/dsh-glass/tree/main/turn-resume#readme",
  "publishConfig": {
    "access": "public"
  }
}
