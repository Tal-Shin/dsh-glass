{
  "name": "@tal-shin/dsh-liquid-glass",
  "version": "0.1.1",
  "type": "module",
  "description": "Liquid-glass material for the floating chrome: menus, dialogs and the composer card.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "displayName": "Liquid Glass",
    "description": "Liquid-glass material for menus, dialogs and the composer card."
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "Tal-Shin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tal-Shin/dsh-glass.git",
    "directory": "liquid-glass"
  },
  "homepage": "https://github.com/Tal-Shin/dsh-glass/tree/main/liquid-glass#readme"
}
